# Copy this file to `.env` and fill in your details.

PORT=3000

# --- Email notifications for new guest suggestions (SMTP) ---
# Google Workspace / Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, use an App Password
# Microsoft 365 / Outlook:  smtp.office365.com, port 587, SMTP_SECURE=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@ragroup.ae
SMTP_PASS=your-smtp-password

# Who receives the notification (comma-separate several addresses)
MAIL_TO=marketing@ragroup.ae
# Sender shown in the email (must be allowed by your SMTP account)
MAIL_FROM="Founders Table <notifications@ragroup.ae>"
